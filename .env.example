# PostgreSQL / Supabase (PostGIS)
# Python 3.13+: postgresql+psycopg://  |  Docker / Python 3.10–3.12: postgresql://
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# JWT
SECRET_KEY=change-me-in-production

# SMTP (opcional; si no configuras, el PIN se simula en logs)
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASSWORD=tu_app_password

# Modo laboratorio / Selenium en colegio (NO usar en producción)
# Desactiva rate limit y fija PIN de recuperación en consola
TEST_MODE=0
TEST_PIN=123456
